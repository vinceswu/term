import "./libterm.so" as _t:
    @cdecl @safe fn olive_term_enable_raw() -> int
    @cdecl @safe fn olive_term_disable_raw() -> int
    @cdecl @safe fn olive_term_enter_alt_screen() -> int
    @cdecl @safe fn olive_term_leave_alt_screen() -> int
    @cdecl @safe fn olive_term_clear() -> int
    @cdecl @safe fn olive_term_cursor_hide() -> int
    @cdecl @safe fn olive_term_cursor_show() -> int
    @cdecl @safe fn olive_term_cursor_move(x: int, y: int) -> int
    @cdecl @safe fn olive_term_flush() -> int
    @cdecl @safe fn olive_term_write(s: str) -> int
    @cdecl @safe fn olive_term_begin_sync() -> int
    @cdecl @safe fn olive_term_end_sync() -> int
    @cdecl @safe fn olive_term_cols() -> int
    @cdecl @safe fn olive_term_rows() -> int
    @cdecl @safe fn olive_term_is_tty() -> int
    @cdecl @safe fn olive_term_enable_key_enhancement() -> int
    @cdecl @safe fn olive_term_disable_key_enhancement() -> int
    @cdecl @safe fn olive_term_enable_mouse() -> int
    @cdecl @safe fn olive_term_disable_mouse() -> int
    @cdecl @safe fn olive_term_clipboard_write(s: str) -> int
    @cdecl @safe fn olive_term_read_key() -> str
    @cdecl @safe fn olive_term_read_key_timeout(ms: int) -> str

/// Key or mouse event from the terminal.
enum Key:
    Enter
    ShiftEnter
    Backspace
    Tab
    BackTab
    Escape
    Up
    Down
    Left
    Right
    Home
    End
    Delete
    PageUp
    PageDown
    Insert
    F(int)
    Ctrl(str)
    Mod(str, str)
    Char(str)
    Resize
    Eof
    Idle
    WheelUp
    WheelDown
    MouseDown(int, int)
    MouseDrag(int, int)
    MouseUp(int, int)

/// Turn on raw mode. Keys come in as you type them, no buffering, no echo.
fn enable_raw() -> bool:
    return _t.olive_term_enable_raw() != 0

/// Turn off raw mode and go back to normal terminal behavior.
fn disable_raw() -> bool:
    return _t.olive_term_disable_raw() != 0

/// Switch to the alternate screen. The user's shell output stays untouched underneath.
fn enter_alt_screen() -> bool:
    return _t.olive_term_enter_alt_screen() != 0

/// Go back to the normal screen.
fn leave_alt_screen() -> bool:
    return _t.olive_term_leave_alt_screen() != 0

/// Clear everything on screen.
fn clear() -> bool:
    return _t.olive_term_clear() != 0

/// Hide the cursor.
fn cursor_hide() -> bool:
    return _t.olive_term_cursor_hide() != 0

/// Show the cursor again.
fn cursor_show() -> bool:
    return _t.olive_term_cursor_show() != 0

/// Move the cursor to column x, row y. Both are 0-based.
fn cursor_move(x: int, y: int) -> bool:
    return _t.olive_term_cursor_move(x, y) != 0

/// Flush any buffered output to the screen right now.
fn flush() -> bool:
    return _t.olive_term_flush() != 0

/// Write a string to the terminal. No newline added.
fn write(s: str) -> bool:
    return _t.olive_term_write(s) != 0

/// Start batching writes. Nothing gets drawn until you call end_sync().
fn begin_sync() -> bool:
    return _t.olive_term_begin_sync() != 0

/// Stop batching and flush everything at once.
fn end_sync() -> bool:
    return _t.olive_term_end_sync() != 0

/// How many columns wide the terminal is.
fn cols() -> int:
    return _t.olive_term_cols()

/// How many rows tall the terminal is.
fn rows() -> int:
    return _t.olive_term_rows()

/// Returns true if stdout is a real terminal, not a pipe or file.
fn is_tty() -> bool:
    return _t.olive_term_is_tty() != 0

/// Ask the terminal for better key events, like telling shift+enter apart from enter.
fn enable_key_enhancement() -> bool:
    return _t.olive_term_enable_key_enhancement() != 0

/// Turn off enhanced key events.
fn disable_key_enhancement() -> bool:
    return _t.olive_term_disable_key_enhancement() != 0

/// Start receiving mouse clicks, drags, and scroll events.
fn enable_mouse() -> bool:
    return _t.olive_term_enable_mouse() != 0

/// Stop receiving mouse events.
fn disable_mouse() -> bool:
    return _t.olive_term_disable_mouse() != 0

/// Copy text to the clipboard. Works over SSH and inside tmux too.
fn clipboard_write(s: str) -> bool:
    return _t.olive_term_clipboard_write(s) != 0

const _MOD_PREFIXES = ["", "ctrl+", "alt+", "shift+", "ctrl+alt+", "ctrl+shift+", "alt+shift+", "ctrl+alt+shift+"]
const _MOD_NAMES = ["", "ctrl", "alt", "shift", "ctrl+alt", "ctrl+shift", "alt+shift", "ctrl+alt+shift"]
const _NAMED_BASES = ["up", "down", "left", "right", "home", "end", "delete", "backspace", "tab", "backtab", "escape", "pageup", "pagedown", "insert"]

fn _bare_named(base: str) -> Key:
    if base == "up":
        return Up
    if base == "down":
        return Down
    if base == "left":
        return Left
    if base == "right":
        return Right
    if base == "home":
        return Home
    if base == "end":
        return End
    if base == "delete":
        return Delete
    if base == "backspace":
        return Backspace
    if base == "tab":
        return Tab
    if base == "backtab":
        return BackTab
    if base == "escape":
        return Escape
    if base == "pageup":
        return PageUp
    if base == "pagedown":
        return PageDown
    return Insert

fn _named_or_mod(tag: str) -> Key | None:
    let mut mi = 0
    while mi < len(_MOD_PREFIXES):
        let prefix = _MOD_PREFIXES[mi]
        let modname = _MOD_NAMES[mi]

        let mut fi = 1
        while fi <= 12:
            let candidate = prefix + "f" + str(fi)
            if tag == candidate:
                if modname == "":
                    return F(fi)
                return Mod(modname, "f" + str(fi))
            fi = fi + 1

        let mut bi = 0
        while bi < len(_NAMED_BASES):
            let base = _NAMED_BASES[bi]
            let candidate = prefix + base
            if tag == candidate:
                if modname == "":
                    return _bare_named(base)
                return Mod(modname, base)
            bi = bi + 1

        mi = mi + 1

    return None

fn _starts_with(s: str, prefix: str) -> bool:
    let n = len(prefix)
    if len(s) < n:
        return False
    return s[0:n] == prefix

fn _decode(tag: str) -> Key:
    if len(tag) == 1:
        return Char(tag)
    if tag == "enter":
        return Enter
    if tag == "shift+enter":
        return ShiftEnter
    if tag == "resize":
        return Resize
    if tag == "eof":
        return Eof
    if tag == "idle":
        return Idle
    if tag == "wheelup":
        return WheelUp
    if tag == "wheeldown":
        return WheelDown

    if _starts_with(tag, "mousedown:"):
        let sub = tag[10:]
        let idx = _find_colon(sub)
        if idx > 0:
            let col = _parse_int(sub[0:idx])
            let row = _parse_int(sub[idx + 1:])
            return MouseDown(col, row)

    if _starts_with(tag, "mousedrag:"):
        let sub = tag[10:]
        let idx = _find_colon(sub)
        if idx > 0:
            let col = _parse_int(sub[0:idx])
            let row = _parse_int(sub[idx + 1:])
            return MouseDrag(col, row)

    if _starts_with(tag, "mouseup:"):
        let sub = tag[8:]
        let idx = _find_colon(sub)
        if idx > 0:
            let col = _parse_int(sub[0:idx])
            let row = _parse_int(sub[idx + 1:])
            return MouseUp(col, row)

    let named = _named_or_mod(tag)
    if named != None:
        return named

    if _starts_with(tag, "ctrl+"):
        return Ctrl(tag[5:])

    return Char(tag)

fn _find_colon(s: str) -> int:
    let mut i = 0
    while i < len(s):
        if s[i:i+1] == ":":
            return i
        i = i + 1
    return -1

fn _parse_int(s: str) -> int:
    return int(s)

/// Wait for the next key press, mouse event, or window resize.
fn read_key() -> Key:
    return _decode(_t.olive_term_read_key())

/// Same as read_key, but returns Idle after ms milliseconds if no event occurred.
fn read_key_timeout(ms: int) -> Key:
    return _decode(_t.olive_term_read_key_timeout(ms))
